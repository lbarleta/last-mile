# Copy to .env on the deploy host (gitignored):
#   cp .env.example .env

# --- Database (required) ---------------------------------------------------
# On PythonAnywhere the database name is prefixed with your username:
#   LASTMILE_DATABASE_URL=mysql://user:password@user.mysql.pythonanywhere-services.com/user$lastmile
#
# Locally:
#   LASTMILE_DATABASE_URL=mysql://lastmile:lastmile@127.0.0.1:3306/lastmile

# --- Analytics ------------------------------------------------------------
# UMAMI_WEBSITE_ID=your-umami-website-id
