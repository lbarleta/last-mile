# Copy to .env on the deploy host (gitignored):
#   cp .env.example .env
#
# Every key in lastmile.toml can be overridden here with an environment
# variable named LASTMILE_<KEY>. Values set here win over the TOML file, and
# real environment variables win over this file. Use it for secrets and
# host-specific values; use lastmile.toml for tunables you want in git.

# --- Database (required) ---------------------------------------------------
LASTMILE_DATABASE_URL='mysql://example_user:example_password@host:3306/lastmile'

# --- Analytics (optional) --------------------------------------------------
# LASTMILE_UMAMI_WEBSITE_ID=your-umami-website-id

# --- Other overrides (optional) --------------------------------------------
# Point at a config file outside the project directory:
# LASTMILE_CONFIG=/etc/lastmile/lastmile.toml
# Widen the walk-shed used for coverage, without editing lastmile.toml:
# LASTMILE_COVERAGE_RADIUS_M=400
