# Copy to .env on the deploy host (gitignored):
#   cp .env.example .env

# --- Database (required) ---------------------------------------------------
# Quote the URL with SINGLE quotes. PythonAnywhere database names contain a '$'
# (they are prefixed with your username), and anything that reads this file
# through `source` would otherwise expand '$lastmile' to nothing and silently
# connect to the wrong database.
#
# PythonAnywhere:
#   LASTMILE_DATABASE_URL='mysql://user:password@user.mysql.pythonanywhere-services.com/user$lastmile'
#
# Locally:
#   LASTMILE_DATABASE_URL='mysql://lastmile:lastmile@127.0.0.1:3306/lastmile'
#
# A password containing @ : / or # must be percent-encoded.

# --- Analytics ------------------------------------------------------------
# UMAMI_WEBSITE_ID=your-umami-website-id
